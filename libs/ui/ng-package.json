{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/ui",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*.css",
      "ignore": [
        "package/**"
      ],
      "output": "styles"
    },
    {
      "input": "src/styles/package",
      "glob": "*.css",
      "output": "."
    },
    {
      "input": "src/assets",
      "glob": "**/*.svg",
      "output": "assets"
    }
  ]
}
